# ScreenScraper.fr Developer API Credentials
# These are required for the application to work with the ScreenScraper API.
# 
# To obtain these credentials:
# 1. Register at https://www.screenscraper.fr/
# 2. Go to https://www.screenscraper.fr/webapi2.php and request API developer access
# 3. You'll receive a developer ID and password
# 4. Copy the values from that email and replace the placeholders below
#
# IMPORTANT: Never commit real credentials to git. This file contains only placeholders.
# For development, create a .env.local file with your actual credentials (git-ignored).
# For deployments, set these as environment variables in your deployment configuration.

# Developer ID for ScreenScraper API
SCREENSCRAPER_DEV_ID=placeholder_dev_id

# Developer Password for ScreenScraper API  
SCREENSCRAPER_DEV_PASSWORD=placeholder_dev_password

# Debug mode (optional — limited to 100 uses/day)
# 
# SCREENSCRAPER_DEBUG_PASSWORD: Your debug password from screenscraper.fr
#   Enables debug mode for testing and concurrent thread limits
#   See: https://www.screenscraper.fr/webapi2.php (MODE DEBUG POUR DEVELOPPEUR)
#
# SCREENSCRAPER_FORCE_LEVEL: User level for thread count testing (optional)
#   The API returns different maxthreads values for different user levels:
#     Level 30 = 1 thread (very slow)
#     Level 50+ = more threads (faster, recommended for testing)
#   See userlevelsListe.php for all available levels
#   Leave empty to use your actual developer account's level
#
# SCREENSCRAPER_FORCE_UPDATE: Force cache refresh during testing
#   Set to "1" to force API cache update (uses one debug quota)
#
SCREENSCRAPER_DEBUG_PASSWORD=
SCREENSCRAPER_FORCE_LEVEL=
SCREENSCRAPER_FORCE_UPDATE=
